{
  "version": 2,
  "buildCommand": "",
  "outputDirectory": "",
  "installCommand": "",
  "framework": null,
  "rewrites": [
    { "source": "/(.*)", "destination": "/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Cache-Control", "value": "public, max-age=60, stale-while-revalidate=30" }
      ]
    }
  ]
}
